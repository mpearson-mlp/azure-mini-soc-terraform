// Query 1: Confirm Windows security events arrive
SecurityEvent
| where TimeGenerated > ago(24h)
| sort by TimeGenerated desc
| take 50

// Query 2: Failed logons
SecurityEvent
| where TimeGenerated > ago(24h) and EventID == 4625
| project TimeGenerated, Computer, Account, EventID, Activity
| sort by TimeGenerated desc

// Query 3: Count failed logons by VM
SecurityEvent
| where TimeGenerated > ago(1h) and EventID == 4625
| summarize FailedAttempts=count() by Computer
| sort by FailedAttempts desc
